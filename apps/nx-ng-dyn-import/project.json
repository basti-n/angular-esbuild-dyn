{
  "name": "nx-ng-dyn-import",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nx-ng-dyn-import/src",
  "projectType": "application",
  "prefix": "app",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/nx-ng-dyn-import",
        "index": "apps/nx-ng-dyn-import/src/index.html",
        "browser": "apps/nx-ng-dyn-import/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/nx-ng-dyn-import/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/nx-ng-dyn-import/public",
            "output": "/assets"
          }
        ],
        "styles": ["apps/nx-ng-dyn-import/src/styles.css"],
        "scripts": [],
        "optimization": {
          "scripts": true,
          "styles": true,
          "fonts": true
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "extractLicenses": false,
          "sourceMap": true,
          "optimization": false,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "development"

    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "buildTarget": "nx-ng-dyn-import:build",
        "prebundle": false,
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "nx-ng-dyn-import:build:production"
        },
        "development": {
          "buildTarget": "nx-ng-dyn-import:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "nx-ng-dyn-import:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/nx-ng-dyn-import/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "nx-ng-dyn-import:build",
        "staticFilePath": "dist/apps/nx-ng-dyn-import/browser",
        "spa": true
      }
    }
  }
}
